  "generator_script": "\"\"\"Frozen validation training summary; epoch-selection noise seed10 only.\"\"\"\nimport csv\nfrom datetime import datetime, timezone\nimport hashlib\nimport json\nfrom pathlib import Path\nimport os\nos.environ.setdefault('MPLCONFIGDIR', '/tmp/ect_matplotlib')\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nROOT = Path('/home/lucky/devdir/rgzndl')\nFOLDER = ROOT / 'results/experiments/formal_v1'\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef main():\n    target = FOLDER / 'training_summary.json'\n    assert not target.exists()\n    registry = json.loads((FOLDER / 'registry.json').read_text())\n    verified = json.loads((FOLDER / 'training_verification.json').read_text())\n    assert verified['status'] == 'passed' and len(verified['runs']) == 9\n    reports = {}\n    for run in registry['runs']:\n        path = ROOT / run['output_dir'] / 'report.json'\n        reports[run['run_id']] = json.loads(path.read_text())\n        check = next(x for x in verified['runs'] if x['run_id'] == run['run_id'])\n        assert sha(path) == check['report_sha256']\n    baseline_path = ROOT / registry['plan']['baseline_report']\n    assert sha(baseline_path) == registry['baseline_report_sha256']\n    baseline = json.loads(baseline_path.read_text())\n    selected = baseline['candidates'][baseline['selected_candidate']]\n    families = ('cnn_clean', 'resnet_clean', 'resnet_aug')\n    summary = dict(schema_version=1, created_utc=datetime.now(timezone.utc).isoformat(),\n        scope='Validation only. All 3200 rows. Clean once per selected model; noisy conditions '\n              'use epoch-selection seed10 only, not the registered repeats10..14.',\n        test_classification_evaluated=False,\n        training_seeds=[0, 1, 2], noise_seed=10, noise_namespace='validation',\n        statistic='Mean and sample SD across three training seeds on one fixed split; '\n                  'not a population confidence interval.',\n        augmentation_comparison='Training noise and epoch-selection objective both differ.',\n        class_mapping_status='unverified; class_index metrics only',\n        files_sha256={'registry.json': sha(FOLDER / 'registry.json'),\n                      'training_verification.json': sha(FOLDER / 'training_verification.json'),\n                      registry['plan']['baseline_report']: sha(baseline_path)},\n        generator_script_sha256=sha(__file__), generator_script=Path(__file__).read_text(),\n        baseline=dict(selected_candidate=baseline['selected_candidate'], clean_metrics=selected['metrics'],\n                      deterministic=True, training_seed_sd=None), families={}, runs=[])\n    for run in registry['runs']:\n        report = reports[run['run_id']]\n        summary['files_sha256'][str(Path(run['output_dir']) / 'report.json')] = sha(ROOT / run['output_dir'] / 'report.json')\n        summary['runs'].append(dict(run_id=run['run_id'], family=run['family'], seed=run['seed'],\n            epochs_executed=len(report['epochs']), selected_epoch_zero_based=report['selected_epoch'],\n            selected_epoch_one_based=report['selected_epoch'] + 1,\n            conditions={c: {m: x[m] for m in ('accuracy', 'macro_f1')}\n                        for c, x in report['validation_metrics'].items()}))\n    for family in families:\n        runs = [x for x in summary['runs'] if x['family'] == family]\n        assert [x['seed'] for x in runs] == [0, 1, 2]\n        summary['families'][family] = {\n            c: {m: {'mean': float(np.mean([x['conditions'][c][m] for x in runs])),\n                    'sample_sd': float(np.std([x['conditions'][c][m] for x in runs], ddof=1)), 'n_training_seeds': 3}\n                for m in ('accuracy', 'macro_f1')} for c in ('clean', '30', '20', '10')}\n    with (FOLDER / 'training_summary.csv').open('w', newline='') as handle:\n        writer = csv.writer(handle, lineterminator='\\n')\n        writer.writerow(['run_id', 'family', 'training_seed', 'epochs_executed', 'selected_epoch_one_based',\n                         'condition', 'noise_seed', 'accuracy', 'macro_f1'])\n        for run in summary['runs']:\n            for c, metrics in run['conditions'].items():\n                writer.writerow([run['run_id'], run['family'], run['seed'], run['epochs_executed'],\n                    run['selected_epoch_one_based'], c, '' if c == 'clean' else 10,\n                    metrics['accuracy'], metrics['macro_f1']])\n    # Clean comparison: SVM single deterministic selected model, no invented seed variance.\n    fig, axes = plt.subplots(1, 2, figsize=(10.8, 4.5), constrained_layout=True)\n    names = ['SVM', 'CNN', 'ResNet', 'ResNet + noise']\n    colors = ['#63788c', '#286d9b', '#d18b36', '#579378']\n    for ax, metric, title in zip(axes, ('accuracy', 'macro_f1'), ('Accuracy', 'Macro-F1')):\n        means = [selected['metrics'][metric]] + [summary['families'][f]['clean'][metric]['mean'] for f in families]\n        errors = [0] + [summary['families'][f]['clean'][metric]['sample_sd'] for f in families]\n        ax.bar(range(4), means, color=colors, alpha=.75)\n        ax.errorbar(range(1, 4), means[1:], yerr=errors[1:], fmt='none', color='black', capsize=5)\n        for i, family in enumerate(families, start=1):\n            values = [x['conditions']['clean'][metric] for x in summary['runs'] if x['family'] == family]\n            ax.scatter(np.array([i] * 3) + [-.12, 0, .12], values, c='#20252b', s=20, zorder=3)\n        ax.set(xticks=range(4), xticklabels=names, ylim=(0, 1), ylabel=title)\n        ax.grid(axis='y', alpha=.2)\n    fig.suptitle('Clean validation: SVM vs three training seeds per network\\nError bars: sample SD across training seeds; test held out', fontsize=11)\n    fig.savefig(FOLDER / 'clean_validation.png', dpi=180)\n    fig.savefig(FOLDER / 'clean_validation.svg')\n    plt.close(fig)\n    fig, axes = plt.subplots(3, 2, figsize=(10.8, 9), constrained_layout=True)\n    for row, family in enumerate(families):\n        for run in [r for r in registry['runs'] if r['family'] == family]:\n            report = reports[run['run_id']]\n            epochs = report['epochs']\n            x = np.arange(1, len(epochs) + 1)\n            conditions = ('clean', '30', '20', '10') if family == 'resnet_aug' else ('clean',)\n            scores = [np.mean([e['validation_metrics'][c]['macro_f1'] for c in conditions]) for e in epochs]\n            axes[row, 0].plot(x, [e['train_loss'] for e in epochs], label=f\"seed {run['seed']}\")\n            line, = axes[row, 1].plot(x, scores, label=f\"seed {run['seed']}\")\n            e = report['selected_epoch']\n            axes[row, 1].scatter(e + 1, scores[e], color=line.get_color(), edgecolor='black', zorder=3)\n        axes[row, 0].set(title=f'{family}: training loss', ylabel='Cross-entropy', xlabel='Epoch (1-based)')\n        axes[row, 1].set(title=f'{family}: selection Macro-F1', ylabel='Mean four conditions' if family == 'resnet_aug' else 'Clean',\n                         xlabel='Epoch (1-based)', ylim=(0, .35))\n        for ax in axes[row]:\n            ax.grid(alpha=.2)\n            ax.legend(fontsize=8)\n    fig.suptitle('Frozen protocol: train loss and validation selection curves\\nDots show selected epochs; noisy validation uses seed10 only', fontsize=12)\n    fig.savefig(FOLDER / 'learning_curves.png', dpi=180)\n    fig.savefig(FOLDER / 'learning_curves.svg')\n    plt.close(fig)\n    for name in ('clean_validation.svg', 'learning_curves.svg'):\n        svg = FOLDER / name\n        svg.write_text('\\n'.join(line.rstrip() for line in svg.read_text().splitlines()) + '\\n', newline='\\n')\n    summary['output_files_sha256'] = {n: sha(FOLDER / n) for n in\n        ('training_summary.csv', 'clean_validation.png', 'clean_validation.svg', 'learning_curves.png', 'learning_curves.svg')}\n    target.write_text(json.dumps(summary, indent=2, allow_nan=False) + '\\n', newline='\\n')\n\n\nif __name__ == '__main__':\n    main()\n",
