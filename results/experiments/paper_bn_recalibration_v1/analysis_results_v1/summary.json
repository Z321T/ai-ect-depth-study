    "text": "from datetime import datetime,timezone\nimport csv,hashlib,json,math,os\nfrom pathlib import Path\nimport sys\nimport numpy as np\nos.environ['MPLCONFIGDIR']='/tmp/ect_bn_mpl'\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nROOT=Path('/home/lucky/devdir/rgzndl');folder=ROOT/'results/experiments/paper_bn_recalibration_v1';out=folder/'analysis_results_v1'\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\ndef read(p):return json.loads(Path(p).read_text())\ndef write(p,value):Path(p).write_text(json.dumps(value,indent=2,allow_nan=False)+'\\n',newline='\\n')\nassert not out.exists()\nregistry=read(folder/'registry.json');status=read(folder/'execution_status.json')\nassert status['status']=='all_calibration_and_cuda_verification_complete'\nassert sha(folder/'registry.json')==status['registry_sha256']\ninputs={}\ndef bind(p,expected=None):\n p=Path(p);digest=sha(p)\n if expected is not None:assert digest==expected,p\n label=p.relative_to(ROOT).as_posix();assert inputs.get(label,digest)==digest;inputs[label]=digest\n return digest\nbind(folder/'registry.json');bind(folder/'execution_status.json')\nfor p,s in registry['code_sha256'].items():bind(ROOT/p,s)\nfor p,s in registry['files_sha256'].items():bind(ROOT/p,s)\nentries=[];groups=[];classes=[];pairs=[]\nfor item in registry['runs']:\n run=ROOT/item['output_dir'];report=read(run/'report.json');proof_path=folder/'verification'/f'{item[\"run_id\"]}_cuda.json';proof=read(proof_path)\n bind(run/'report.json');bind(proof_path)\n assert report['status']=='complete' and report['code_sha256']==registry['code_sha256']\n assert proof['status']=='verified' and proof['report_sha256']==sha(run/'report.json')\n assert proof['prediction_counts']=={'train':24000,'validation':3200} and proof['maximum_metric_error']==0\n assert proof['same_device_calibration_exact'] and proof['calibration_buffer_max_abs_error']==0\n assert proof['checks']['prediction_class_mismatches']==0 and proof['checks']['parameters_unchanged']\n for p,s in report['files_sha256'].items():bind(run/p,s)\n for p,s in proof['checked_files_sha256'].items():bind(Path(p),s)\n baseline=read(ROOT/item['origin_run']/'report.json');seed=item['seed']\n pair=dict(seed=seed,selected_epoch=report['selected_epoch'],calibration=report['calibration'],elapsed_seconds=report['elapsed_seconds'])\n for split in ('train','validation'):\n  pair[split]={v:{k:m[k] for k in ('accuracy','macro_f1')} for v,m in [('baseline',baseline['metrics'][split]),('recalibrated',report['metrics'][split])]}\n  pair[split]['delta']={k:report['metrics'][split][k]-baseline['metrics'][split][k] for k in ('accuracy','macro_f1')}\n  for variant,result in [('baseline',baseline),('recalibrated',report)]:\n   metric=result['metrics'][split];entries.append(dict(seed=seed,split=split,variant=variant,accuracy=metric['accuracy'],macro_f1=metric['macro_f1']))\n   for group,m in result['group_metrics'][split].items():\n    n=sum(sum(row) for row in m['confusion_matrix']);groups.append(dict(seed=seed,split=split,variant=variant,group_id=group,sample_count=n,accuracy=m['accuracy'],macro_f1=m['macro_f1']))\n   for cls,m in metric['per_class'].items():classes.append(dict(seed=seed,split=split,variant=variant,class_index=cls,**m))\n  if split=='train':\n   pair['training_group_diagnostics']={}\n   for variant,result in [('baseline',baseline),('recalibrated',report)]:\n    vals=result['group_metrics']['train'];d={}\n    for key,which in [('large',['1','2']),('other',[g for g in vals if g not in ['1','2']])]:\n     counts=[sum(sum(row) for row in vals[g]['confusion_matrix']) for g in which]\n     d[key]=sum(vals[g]['accuracy']*n for g,n in zip(which,counts))/sum(counts)\n    d['large_minus_other']=d['large']-d['other'];pair['training_group_diagnostics'][variant]=d\n pairs.append(pair)\naggregate={}\nfor split in ('train','validation'):\n aggregate[split]={}\n for metric in ('accuracy','macro_f1'):\n  d={}\n  for variant in ('baseline','recalibrated','delta'):\n   values=[p[split][variant][metric] for p in pairs]\n   d[variant]=dict(values=values,mean=float(np.mean(values)),sample_sd=float(np.std(values,ddof=1)),minimum=min(values),maximum=max(values))\n  aggregate[split][metric]=d\nout.mkdir();figures=out/'figures';figures.mkdir()\nfor filename,rows in [('metrics.csv',entries),('groups.csv',groups),('per_class.csv',classes)]:\n with (out/filename).open('w',newline='') as h:\n  w=csv.DictWriter(h,fieldnames=list(rows[0]),lineterminator='\\n');w.writeheader();w.writerows(rows)\nplt.rcParams.update({'font.size':10,'axes.spines.top':False,'axes.spines.right':False})\nfig,axes=plt.subplots(1,2,figsize=(10,4.3));pos=np.arange(3);colors=['#0072B2','#D55E00']\nfor ax,metric,label in zip(axes,['accuracy','macro_f1'],['Accuracy (%)','Macro-F1 (%)']):\n for i,variant in enumerate(['baseline','recalibrated']):\n  values=np.array([p['validation'][variant][metric] for p in pairs])*100\n  bars=ax.bar(pos+(i-.5)*.35,values,width=.35,color=colors[i],label=variant)\n  ax.bar_label(bars,fmt='%.2f',padding=3,fontsize=9)\n ax.set(xticks=pos,xticklabels=[f'Seed {p[\"seed\"]}' for p in pairs],ylabel=label,ylim=(0,100));ax.legend();ax.grid(axis='y',alpha=.2)\nfig.suptitle('Frozen weights: original BN vs train-only recalibration\\nValidation; same selected epoch and fixed ten-crop inference',fontsize=12)\nfig.tight_layout();fig.savefig(figures/'validation_comparison.png',dpi=180);fig.savefig(figures/'validation_comparison.svg');plt.close(fig)\nfig,axes=plt.subplots(1,3,figsize=(14,4.8))\nfor ax,pair in zip(axes,pairs):\n seed=pair['seed'];g=[r for r in groups if r['seed']==seed and r['split']=='train'];names=sorted(set(r['group_id'] for r in g),key=int);x=np.arange(len(names))\n for i,variant in enumerate(['baseline','recalibrated']):\n  values=[next(r['accuracy'] for r in g if r['variant']==variant and r['group_id']==n)*100 for n in names]\n  ax.bar(x+(i-.5)*.35,values,width=.35,color=colors[i],label=variant)\n ax.set(xticks=x,xticklabels=names,ylabel='Train eval Accuracy (%)',xlabel='Connection group',ylim=(0,100),title=f'Seed {seed}')\n ax.grid(axis='y',alpha=.2)\naxes[0].legend(loc='lower left',fontsize=8)\nfig.suptitle('Same eval / ten crops; group 1 and 2: 8000 rows each; others: 1600 each\\nConnection groups are not confirmed acquisition-person identities',fontsize=11)\nfig.tight_layout();fig.savefig(figures/'training_groups.png',dpi=180);fig.savefig(figures/'training_groups.svg');plt.close(fig)\nfor p in figures.glob('*.svg'):p.write_bytes(p.read_bytes().replace(b'\\r\\n',b'\\n'))\noutputs={p.relative_to(out).as_posix():sha(p) for p in out.rglob('*') if p.is_file()}\nsummary=dict(schema_version=1,status='complete',protocol='paper_bn_recalibration_analysis_v1',created_utc=datetime.now(timezone.utc).isoformat(),\n registry_sha256=sha(folder/'registry.json'),execution_source_commit='a619000',test_classification_enabled=False,\n model_count=3,new_prediction_count=81600,calibration_sample_count=72000,source_weight_parameters_changed=0,\n pairs=pairs,aggregate=aggregate,all_seed_validation_accuracy_deltas_positive=all(p['validation']['delta']['accuracy']>0 for p in pairs),\n note='Exploratory fixed-weight postprocessing on the same split; seed sample SD is not a confidence interval. No checkpoint reselection.',\n inputs_sha256=inputs,outputs_sha256=outputs,execution_script=dict(text=Path(__file__).read_text(),sha256=sha(__file__)))\nfor p,s in inputs.items():assert sha(ROOT/p)==s,p\nwrite(out/'summary.json',summary)\nprint(json.dumps(dict(status='complete',checked_inputs=len(inputs),validation=aggregate['validation'],pairs=pairs),indent=2))\n",
